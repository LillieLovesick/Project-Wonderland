[sub_resource type="Shader" id="Shader_otnc2"]
code = "shader_type spatial;

uniform sampler2D noise;

void vertex() {
	VERTEX.y += sin(TIME + VERTEX.x + VERTEX.z) * 0.2;
}

void fragment() {
	ALPHA = texture(noise, SCREEN_UV + vec2(1.0, 1.0) * TIME * 0.25).r;
}

